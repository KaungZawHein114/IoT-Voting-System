<%- include('../partials/head') %>
<% const basePath = panelRole === 'ADMIN' ? '/admin' : '/manager'; %>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <div class="app-frame">
    <%- include('../partials/topbar') %>
    <main class="page">
      <header class="page-header">
        <div class="detail-header">
          <a class="back-link" href="<%= basePath %>/projects/<%= project._id %>"><img src="/icons/arrow-left.svg" alt="Back" /></a>
          <div><h2><%= project.batch %> results</h2><p>Voting results for <%= project.theme || 'this project show' %></p></div>
        </div>
        <span class="status-badge status-voting_closed">Voting closed</span>
      </header>

      <div class="metric-grid">
        <div class="metric"><span class="metric-label"><img src="/icons/check-circle-2.svg" alt="" /> Votes submitted</span><strong><%= votingStats.votedCount %></strong></div>
        <div class="metric"><span class="metric-label"><img src="/icons/layers-2.svg" alt="" /> Categories</span><strong><%= results.categories.length %></strong></div>
        <div class="metric"><span class="metric-label"><img src="/icons/users.svg" alt="" /> Groups</span><strong><%= results.groups.length %></strong></div>
      </div>

      <% if (results.categories.length) { %>
        <div class="results-list">
          <% results.categories.forEach(category => { %>
            <section class="panel">
              <div class="panel-header"><div><h3><%= category.name %></h3><span class="cell-secondary"><%= category.description %></span></div></div>
              <div class="table-shell standalone" style="border:0"><table><thead><tr><th>Group</th><th>Project title</th><th>Votes</th></tr></thead><tbody>
                <% category.groups.forEach(group => { %>
                  <tr><td class="cell-primary">Group <%= group.groupNumber %></td><td><%= group.title %></td><td class="cell-primary"><%= group.voteCount %></td></tr>
                <% }) %>
              </tbody></table></div>
            </section>
          <% }) %>
        </div>
      <% } else { %>
        <div class="panel"><div class="empty-state"><img src="/icons/bar-chart-3.svg" alt="" /><div>No voting categories were configured.</div></div></div>
      <% } %>

      <section class="panel" style="margin-top: 24px">
        <div class="panel-header">
          <div>
            <h3>Individual votes</h3>
            <span class="cell-secondary">For manual review — votes sharing the same name and batch are flagged below. Remove any vote that looks suspicious; this cannot be undone.</span>
          </div>
        </div>
        <% if (voteRows.length) { %>
          <div class="table-shell standalone" style="border:0">
            <table>
              <thead>
                <tr><th>Voter</th><th>Batch</th><th>Selections</th><th>Submitted</th><th></th></tr>
              </thead>
              <tbody>
                <% voteRows.forEach(vote => {
                  const batchLabel = vote.batchType ? `${vote.batchType}-${vote.batchNumber}` : '—';
                  const selectionsLabel = vote.selections.map(s => `${s.category}: ${s.group}`).join('; ');
                  const confirmMessage = `Delete this vote?\n\nVoter: ${vote.voterName}\nBatch: ${batchLabel}\nSelections: ${selectionsLabel}\n\nThis action cannot be undone.`;
                  const isDuplicate = vote.duplicateCount > 1;
                %>
                  <tr class="<%= isDuplicate ? 'vote-row--duplicate' : '' %>">
                    <td class="cell-primary">
                      <%= vote.voterName %>
                      <% if (isDuplicate) { %>
                        <span class="status-badge status-draft" title="<%= vote.duplicateCount %> votes share this name and batch">Possible duplicate (<%= vote.duplicateCount %>x)</span>
                      <% } %>
                    </td>
                    <td><%= batchLabel %></td>
                    <td class="cell-secondary"><%= selectionsLabel %></td>
                    <td class="cell-secondary"><%= new Date(vote.createdAt).toLocaleString() %></td>
                    <td>
                      <button
                        class="button danger"
                        type="button"
                        data-delete-endpoint="/api/v1/projects/<%= project._id %>/votes/<%= vote.id %>"
                        data-confirm="<%= confirmMessage %>"
                        data-confirm-title="Delete this vote?"
                        data-redirect="<%= basePath %>/projects/<%= project._id %>/results"
                      ><img src="/icons/trash-2.svg" alt="" /> Delete</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state"><img src="/icons/users.svg" alt="" /><div>No votes recorded yet.</div></div>
        <% } %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>