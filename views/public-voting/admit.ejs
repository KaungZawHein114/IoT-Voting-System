<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title><%= pageTitle %> | GUSTO IoT Show</title>
    <link rel="icon" href="/assets/images/gusto-logo.png" />
    <link rel="stylesheet" href="/assets/css/voting.css" />
  </head>
  <body class="admission-page">
    <main
      class="access-state admission-access-state"
      data-admission-page
      aria-busy="true"
      aria-live="polite"
    >
      <img src="/assets/images/gusto-logo.png" alt="GUSTO University" />
      <span class="access-kicker">Public IoT Show</span>
      <h1 data-admission-title>Checking voting access</h1>
      <div class="access-loader" data-admission-loader aria-hidden="true"></div>
      <div class="access-error-mark" data-admission-error-mark hidden aria-hidden="true">!</div>
      <p data-admission-message>Validating the live QR code...</p>
      <p class="access-guidance" data-admission-guidance hidden>
        Look at the Public Show screen and scan the QR code currently displayed.
      </p>
    </main>
    <script src="/assets/js/public-vote-admission.js" defer></script>
  </body>
</html>
