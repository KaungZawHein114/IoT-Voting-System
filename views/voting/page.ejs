<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title><%= pageTitle %> | GUSTO IoT Show</title>
    <link rel="icon" href="/assets/images/gusto-logo.png" />
    <% if (pageState === 'OPEN') { %>
      <script>try{if(sessionStorage.getItem(<%- JSON.stringify(`voting-pass:${splashKey}`) %>))document.documentElement.classList.add("skip-ticket-splash")}catch(error){}</script>
    <% } %>
    <link rel="stylesheet" href="/assets/css/voting.css" />
  </head>
  <body class="voting-app-page">
    <% if (pageState !== 'OPEN') { const stateContent = { NO_ACCESS: ['Voting access required', 'Scan the live QR code displayed at the project show to enter voting.'], EXPIRED: ['Voting access expired', 'This voting chance is no longer valid. Scan the current QR code if voting is still open.'], CLOSED: ['Voting is closed', 'This voting session can no longer submit a vote.'], VOTED: ['Vote submitted', 'Your selections have been recorded. This voting session cannot vote again.'] }[pageState]; %>
      <main class="access-state">
        <div class="access-brand"><img src="/assets/images/gusto-logo.png" alt="GUSTO University" /></div>
        <span class="access-kicker"><%= project.batch %> Project Show</span>
        <h1><%= stateContent[0] %></h1>
        <p><%= stateContent[1] %></p>
        <% if (pageState === 'VOTED') { %><span class="success-mark"><img src="/icons/check.svg" alt="" /></span><% } %>
      </main>
    <% } else { const show = project.projectShow || {}; const location = show.location || {}; %>
      <div class="ticket-splash" data-ticket-splash data-splash-key="<%= splashKey %>" role="status" aria-live="polite">
        <div class="ticket-stage">
          <div class="voting-ticket">
            <div class="ticket-body">
              <div class="ticket-heading"><span>Entry pass</span><strong><%= project.batch %></strong></div>
              <div class="ticket-validation"><img src="/icons/check.svg" alt="" /></div>
              <span class="ticket-label">Your ballot is ready</span>
              <h1>One voting opportunity</h1>
              <p>Review the projects carefully, then submit one complete ballot.</p>
            </div>
            <div class="ticket-stub"><strong>01</strong><span>Ballot</span></div>
          </div>
          <div class="ticket-status"><i></i><span>Access verified</span></div>
        </div>
      </div>

      <header class="app-header">
        <div class="app-header-inner">
          <a class="app-brand" href="#show" data-view-target="show" aria-label="Project show information">
            <img src="/assets/images/gusto-logo.png" alt="" />
            <span><small>IoT Project Show</small><strong><%= project.batch %></strong></span>
          </a>
          <span class="live-status"><i></i><span>Voting open</span></span>
        </div>
      </header>

      <main class="vote-app">
        <section class="app-view show-view" id="view-show" data-app-view="show" aria-labelledby="show-view-title">
          <div class="show-intro">
            <span class="eyebrow">Project show</span>
            <h1 id="show-view-title"><%= project.theme %></h1>
            <p>Explore the work from every group before choosing your projects in each voting category.</p>
          </div>

          <div class="event-facts" aria-label="Project show details">
            <div class="event-fact"><span class="fact-icon"><img src="/icons/calendar-days.svg" alt="" /></span><span><small>Date</small><strong><%= formatDate(show.startDate) %></strong></span></div>
            <div class="event-fact"><span class="fact-icon"><img src="/icons/clock-3.svg" alt="" /></span><span><small>Time</small><strong><%= show.startTime %>–<%= show.endTime %></strong></span></div>
            <div class="event-fact event-location"><span class="fact-icon"><img src="/icons/map-pin.svg" alt="" /></span><span><small>Location</small><strong><%= location.campus %>, <%= location.floor %>, <%= location.room %></strong></span></div>
          </div>

          <div class="show-counts" aria-label="Show overview">
            <div><strong><%= groups.length %></strong><span>Projects</span></div>
            <div><strong><%= categories.length %></strong><span>Categories</span></div>
          </div>

          <button class="primary-action" type="button" data-view-target="projects">
            Explore the projects <img src="/icons/arrow-right.svg" alt="" />
          </button>
        </section>

        <section class="app-view projects-view" id="view-projects" data-app-view="projects" aria-labelledby="projects-view-title" hidden>
          <header class="view-heading">
            <div><span class="eyebrow">Project tour</span><h1 id="projects-view-title">Meet the groups</h1></div>
            <span class="view-counter"><strong data-project-current>1</strong> / <%= groups.length %></span>
          </header>

          <div class="project-tour" aria-live="polite">
            <% groups.forEach((group, groupIndex) => { %>
              <article class="project-feature" data-project-feature="<%= groupIndex %>" <%= groupIndex === 0 ? '' : 'hidden' %>>
                <div class="project-image">
                  <% if (group.images && group.images.length) { %><img src="<%= group.images[0] %>" alt="<%= group.title %>" /><% } else { %><span>G<%= group.groupNumber %></span><% } %>
                  <span class="project-number">Group <%= group.groupNumber %></span>
                </div>
                <div class="project-content">
                  <h2><%= group.title %></h2>
                  <p><%= group.description %></p>
                  <div class="member-section">
                    <span><img src="/icons/users.svg" alt="" /> Team members</span>
                    <ul><% group.members.forEach(member => { %><li><%= member %></li><% }) %></ul>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

          <div class="tour-progress" role="group" aria-label="Choose a project">
            <% groups.forEach((group, groupIndex) => { %><button type="button" data-project-dot="<%= groupIndex %>" class="<%= groupIndex === 0 ? 'active' : '' %>" aria-label="View Group <%= group.groupNumber %>" aria-current="<%= groupIndex === 0 ? 'true' : 'false' %>"></button><% }) %>
          </div>

          <div class="view-actions">
            <button class="secondary-action icon-action" type="button" data-project-previous aria-label="Previous project" disabled><img src="/icons/arrow-left.svg" alt="" /></button>
            <button class="primary-action compact" type="button" data-project-next>Next project <img src="/icons/arrow-right.svg" alt="" /></button>
          </div>
        </section>

        <section class="app-view voting-view" id="view-vote" data-app-view="vote" aria-labelledby="vote-view-title" hidden>
          <form class="ballot" data-vote-form data-batch="<%= project.batch %>" data-csrf="<%= csrfToken %>">
            <header class="view-heading vote-heading">
              <div><span class="eyebrow">Your ballot</span><h1 id="vote-view-title">Choose one project</h1></div>
              <span class="view-counter"><strong data-category-current>1</strong> / <%= categories.length %></span>
            </header>
            <div class="category-progress" aria-hidden="true"><span data-category-progress></span></div>
            <div class="vote-message" data-vote-message role="alert"></div>

            <% categories.forEach((category, categoryIndex) => { %>
              <fieldset class="category-section" data-category-id="<%= category._id %>" data-category-index="<%= categoryIndex %>" <%= categoryIndex === 0 ? '' : 'hidden' %>>
                <legend><strong><%= category.name %></strong><small><%= category.description %></small></legend>
                <div class="group-options">
                  <% groups.forEach(group => { %>
                    <label class="group-option">
                      <input type="radio" name="category-<%= category._id %>" value="<%= group._id %>" required />
                      <span class="group-visual">
                        <% if (group.images && group.images.length) { %><img src="<%= group.images[0] %>" alt="" /><% } else { %><strong>G<%= group.groupNumber %></strong><% } %>
                        <span class="option-check"><img src="/icons/check.svg" alt="Selected" /></span>
                      </span>
                      <span class="group-choice-copy"><small>Group <%= group.groupNumber %></small><strong><%= group.title %></strong></span>
                    </label>
                  <% }) %>
                </div>
              </fieldset>
            <% }) %>

            <div class="view-actions vote-actions">
              <button class="secondary-action" type="button" data-vote-previous><img src="/icons/arrow-left.svg" alt="" /> Back</button>
              <button class="primary-action compact" type="button" data-vote-next>Next category <img src="/icons/arrow-right.svg" alt="" /></button>
              <button class="primary-action compact" type="submit" data-vote-submit hidden><img src="/icons/send.svg" alt="" /> Submit vote</button>
            </div>
          </form>
        </section>
      </main>

      <nav class="app-navigation" aria-label="Voting website sections">
        <button type="button" data-app-nav="show" data-view-target="show" aria-current="page"><img src="/icons/info.svg" alt="" /><span>Show</span></button>
        <button type="button" data-app-nav="projects" data-view-target="projects"><img src="/icons/images.svg" alt="" /><span>Projects</span></button>
        <button type="button" data-app-nav="vote" data-view-target="vote"><img src="/icons/vote.svg" alt="" /><span>Vote</span></button>
      </nav>
      <script src="/assets/js/voting.js" defer></script>
    <% } %>
  </body>
</html>
